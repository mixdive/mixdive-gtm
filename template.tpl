___SANDBOXED_JS_FOR_WEB_TEMPLATE___

// Mixdive — Google Tag Manager tag template.
//
// Sandboxed template code cannot make HTTP requests, so this template loads
// the Mixdive browser SDK (@mixdive/browser, pinned below) and hands every
// action to it through the SDK's call queue: before the SDK has loaded, the
// queue collects the calls; on load the SDK drains them in order and keeps
// accepting pushes, so the same code path works whether a Track event tag
// fires before or after the Initialize tag has finished loading.
const copyFromWindow = require('copyFromWindow');
const setInWindow = require('setInWindow');
const callInWindow = require('callInWindow');
const injectScript = require('injectScript');
const makeNumber = require('makeNumber');
const makeTableMap = require('makeTableMap');
const log = require('logToConsole');

// The SDK build this template version drives. Bumping it is a template update.
const SDK_URL = 'https://cdn.jsdelivr.net/npm/@mixdive/browser@0.1.1/dist/mixdive.js';

function enqueue(entry) {
  if (!copyFromWindow('mixdive')) {
    setInWindow('mixdive', { q: [] }, false);
  }
  callInWindow('mixdive.q.push', entry);
}

function text(v) {
  if (v === undefined || v === null || v === '') return undefined;
  return '' + v;
}

function num(v) {
  if (v === undefined || v === null || v === '') return undefined;
  const n = makeNumber(v);
  if (n !== n) return undefined; // NaN
  return n;
}

if (data.action === 'init') {
  enqueue(['init', {
    key: data.apiKey,
    server: data.serverUrl,
    autoPageViews: data.autoPageViews !== false,
    appVersion: text(data.appVersion),
    debug: data.debug === true
  }]);
  injectScript(SDK_URL, data.gtmOnSuccess, function () {
    log('[Mixdive] could not load the SDK from ' + SDK_URL);
    data.gtmOnFailure();
  }, 'mixdive');
} else if (data.action === 'track') {
  const userId = text(data.eventUserId);
  if (userId) enqueue(['identify', userId]);
  const options = {};
  const count = num(data.count);
  const sum = num(data.sum);
  const duration = num(data.duration);
  const id = text(data.occurrenceId);
  if (count !== undefined) options.count = count;
  if (sum !== undefined) options.sum = sum;
  if (duration !== undefined) options.duration = duration;
  if (id) options.id = id;
  const properties = data.properties && data.properties.length ? makeTableMap(data.properties, 'name', 'value') : undefined;
  enqueue(['track', data.eventKey, properties, options]);
  data.gtmOnSuccess();
} else if (data.action === 'identify') {
  const profile = {};
  const name = text(data.userName);
  const email = text(data.userEmail);
  if (name) profile.name = name;
  if (email) profile.email = email;
  if (name || email) {
    enqueue(['setUser', data.userId, profile]);
  } else {
    enqueue(['identify', data.userId]);
  }
  data.gtmOnSuccess();
} else if (data.action === 'pageView') {
  enqueue(['pageView', text(data.pageUrl)]);
  data.gtmOnSuccess();
} else {
  data.gtmOnFailure();
}


