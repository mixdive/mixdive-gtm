___TESTS___

scenarios:
- name: Initialize loads the SDK after queueing init
  code: |-
    const mockData = {action: 'init', serverUrl: 'https://mixdive.example.com', apiKey: 'mx_test', autoPageViews: true};
    let pushed = [];
    mock('copyFromWindow', () => undefined);
    mock('callInWindow', (path, entry) => { pushed.push(entry); });
    mock('injectScript', (url, onSuccess) => { onSuccess(); });
    runCode(mockData);
    assertApi('setInWindow').wasCalled();
    assertApi('injectScript').wasCalled();
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(pushed.length).isEqualTo(1);
    assertThat(pushed[0][0]).isEqualTo('init');
    assertThat(pushed[0][1].server).isEqualTo('https://mixdive.example.com');
    assertThat(pushed[0][1].key).isEqualTo('mx_test');
- name: Track event with properties and measures
  code: |-
    const mockData = {action: 'track', eventKey: 'checkout_completed', count: '2', sum: '129.9', duration: '', properties: [{name: 'plan', value: 'team'}]};
    let pushed = [];
    mock('copyFromWindow', () => ({q: []}));
    mock('callInWindow', (path, entry) => { pushed.push(entry); });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertApi('setInWindow').wasNotCalled();
    assertThat(pushed.length).isEqualTo(1);
    assertThat(pushed[0][0]).isEqualTo('track');
    assertThat(pushed[0][1]).isEqualTo('checkout_completed');
    assertThat(pushed[0][2].plan).isEqualTo('team');
    assertThat(pushed[0][3].count).isEqualTo(2);
    assertThat(pushed[0][3].sum).isEqualTo(129.9);
    assertThat(pushed[0][3].duration).isEqualTo(undefined);
- name: Track event with a user id identifies first
  code: |-
    const mockData = {action: 'track', eventKey: 'login', eventUserId: 'user-9'};
    let pushed = [];
    mock('copyFromWindow', () => ({q: []}));
    mock('callInWindow', (path, entry) => { pushed.push(entry); });
    runCode(mockData);
    assertThat(pushed.length).isEqualTo(2);
    assertThat(pushed[0][0]).isEqualTo('identify');
    assertThat(pushed[0][1]).isEqualTo('user-9');
    assertThat(pushed[1][0]).isEqualTo('track');
- name: Identify with a profile uses setUser
  code: |-
    const mockData = {action: 'identify', userId: 'user-9', userName: 'Ada', userEmail: ''};
    let pushed = [];
    mock('copyFromWindow', () => ({q: []}));
    mock('callInWindow', (path, entry) => { pushed.push(entry); });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(pushed[0][0]).isEqualTo('setUser');
    assertThat(pushed[0][2].name).isEqualTo('Ada');
    assertThat(pushed[0][2].email).isEqualTo(undefined);
- name: Page view
  code: |-
    const mockData = {action: 'pageView', pageUrl: ''};
    let pushed = [];
    mock('copyFromWindow', () => ({q: []}));
    mock('callInWindow', (path, entry) => { pushed.push(entry); });
    runCode(mockData);
    assertApi('gtmOnSuccess').wasCalled();
    assertThat(pushed[0][0]).isEqualTo('pageView');
    assertThat(pushed[0][1]).isEqualTo(undefined);


